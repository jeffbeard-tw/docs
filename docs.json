{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "MerchantE Developer Center",
  "colors": {
    "primary": "#30BF8F",
    "light": "#80FFBF",
    "dark": "#0F4D42"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/MEbyOmiselogo(onlight).svg",
    "dark": "/images/MEbyOmiselogo(ondark).svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F5F7FA",
      "dark": "#05080D"
    }
  },
  "fonts": {
    "heading": {
      "family": "Outfit",
      "weight": 600
    },
    "body": {
      "family": "DM Sans",
      "weight": 400
    }
  },
  "description": "The MerchantE Developer Center contains information on the MerchantE APIs. Merchant developers integrate and build with MerchantE APIs so their businesses programmatically process, manage, and integrate payment and platform operations directly into their websites, mobile apps, or custom software. The site gives API reference information and integration guides for the Payment Gateway API and other MerchantE APIs.",
  "api": {
    "openapi": "split-funding.json"
  }
}
